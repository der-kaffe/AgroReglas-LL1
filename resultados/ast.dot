digraph arbol {
  label="AST (ejemplo del enunciado)"; labelloc=t; fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11]; edge [arrowhead=none];
  n0 [label="Programa (1 regla)", shape=ellipse];
  n1 [label="Regla (línea 1)", shape=ellipse];
  n2 [label="Condición", shape=ellipse];
  n3 [label="AND", shape=circle, style=filled, fillcolor="#fde9c9"];
  n4 [label="humedad < 30", shape=box, style="rounded,filled", fillcolor="#e8f1e4"];
  n5 [label="NOT", shape=circle, style=filled, fillcolor="#fde9c9"];
  n6 [label="OR", shape=circle, style=filled, fillcolor="#fde9c9"];
  n7 [label="lluvia == TRUE", shape=box, style="rounded,filled", fillcolor="#e8f1e4"];
  n8 [label="viento > 40", shape=box, style="rounded,filled", fillcolor="#e8f1e4"];
  n9 [label="Acciones", shape=ellipse];
  n10 [label="Acción", shape=ellipse];
  n11 [label="verbo: regar", shape=box, style="rounded,filled", fillcolor="#e3ecf7"];
  n12 [label="objetivo: sector_norte", shape=box, style="rounded,filled", fillcolor="#e3ecf7"];
  n13 [label="DURING: 15 min", shape=box, style="rounded,filled", fillcolor="#e3ecf7"];
  n14 [label="Acción", shape=ellipse];
  n15 [label="verbo: activar", shape=box, style="rounded,filled", fillcolor="#e3ecf7"];
  n16 [label="objetivo: alarma", shape=box, style="rounded,filled", fillcolor="#e3ecf7"];
  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4;
  n3 -> n5;
  n5 -> n6;
  n6 -> n7;
  n6 -> n8;
  n1 -> n9;
  n9 -> n10;
  n10 -> n11;
  n10 -> n12;
  n10 -> n13;
  n9 -> n14;
  n14 -> n15;
  n14 -> n16;
}
